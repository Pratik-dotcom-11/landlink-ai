# ============================================================================
# Intelligent Land Record Digitization & Validation System
# Backend Environment Configuration
# ============================================================================

# Application Configuration
APP_NAME="DoLR Intelligent Land Record Digitization & Validation API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Database Configuration
# For PostgreSQL (Production): postgresql://user:password@localhost:5432/landrecords_db
# For SQLite (Local Dev / Fallback): sqlite:///./landrecords.db
DATABASE_URL="sqlite:///./landrecords.db"

# JWT Authentication & Cryptographic Tokens
# In production, use a strong 256-bit key from: openssl rand -hex 32
JWT_SECRET_KEY="dolr-land-records-secure-jwt-secret-key-2026-super-secret-key-32bytes"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","*"]

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# Storage Configuration
UPLOAD_DIR="./storage/documents"
MAX_UPLOAD_SIZE_MB=50
